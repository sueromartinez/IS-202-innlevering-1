@model FirstWebAppInDocker.Models.PositionModel

<h2>Meld inn feil på kartet</h2>

<form asp-action="CorrectMap" method="post">
    <div class="mb-3">
        <label>Latitude</label>
        <input asp-for="Latitude" id="latitude" class="form-control" readonly />
    </div>
    <div class="mb-3">
        <label>Longitude</label>
        <input asp-for="Longitude" id="longitude" class="form-control" readonly />
    </div>
    <div class="mb-3">
        <label>Feilbeskrivelse</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

<div id="map" style="height: 400px; margin-top: 20px;"></div>

<script>
    var map = L.map('map').setView([51.505, -0.09], 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    map.on('click', function (e) {
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;

        L.marker([lat, lng]).addTo(map);
    });
</script>
